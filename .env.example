# Public SumUp API (me.sumup.com -> Developer -> API keys)
# Current format is sup_sk_* (secret) or sup_pk_* (public/restricted).
# Older keys use the sk_live_* / sk_test_* format and still work.
# Copy this file to .env and put the real key there; .env is gitignored.
SUMUP_API_KEY=sup_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: skip a lookup round-trip by pinning the merchant code (e.g. MXXXXXXX)
SUMUP_MERCHANT_CODE=

# Internal me.sumup.com session (needed for inventory/catalog, not covered by the public API)
# Captured from a logged-in browser session; see README "Session capture"
SUMUP_SESSION_TOKEN=

# Override only if SumUp moves hosts
SUMUP_API_BASE=https://api.sumup.com
